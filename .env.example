# -------- Security --------
# Use long random strings in production.
LITELLM_MASTER_KEY=sk-team-master-change-me
LITELLM_SALT_KEY=sk-team-salt-change-me

# -------- LiteLLM DB --------
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=litellm_password_change_me
LITELLM_DB_NAME=litellm
LITELLM_DATABASE_URL=postgresql://litellm:litellm_password_change_me@litellm_db:5432/litellm

# Optional image mirrors to avoid Docker Hub timeout
LITELLM_DB_IMAGE=postgres:16
QDRANT_IMAGE=qdrant/qdrant:latest

# Pull timeout tuning (especially useful under unstable network)
DOCKER_CLIENT_TIMEOUT=180
COMPOSE_HTTP_TIMEOUT=180

# -------- Provider Keys --------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Azure OpenAI (optional)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_GPT41=gpt-4.1
OPEN_WEBUI_PORT=9000

# -------- Team AI Backend --------
TEAM_AI_PLATFORM_PROJECT_NAME=Aegis Nexus AI Platform
TEAM_AI_PLATFORM_API_V1_PREFIX=/api
TEAM_AI_PLATFORM_DEFAULT_ADMIN_EMAIL=admin@example.com
TEAM_AI_PLATFORM_DEFAULT_MODEL_PROVIDER=openai
TEAM_AI_PLATFORM_DEFAULT_MODEL_NAME=gpt-4o
TEAM_AI_PLATFORM_DB_DSN=postgresql://litellm:litellm_password_change_me@litellm_db:5432/litellm
